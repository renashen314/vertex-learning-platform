# Canonical list of every environment variable this app reads.
# Copy to .env.local and fill in. Never commit real values.

# --- Clerk (auth) ---
# Publishable key is client-safe. The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Sanity (content) ---
# Project id, dataset, and API version are not secrets and may reach the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Read token for the private dataset. SERVER ONLY — never prefix NEXT_PUBLIC_.
# Create with: npx sanity tokens add "vertex-web-read" --role viewer
SANITY_API_READ_TOKEN=

# --- PostHog (analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
